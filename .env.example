# Copy this file to `.env` and fill in the values from your EmailJS dashboard.
# `.env` is gitignored. This file (.env.example) is safe to commit.
#
# Only the VITE_ prefix is exposed to the browser by Vite. Every value below is
# meant to be public — EmailJS designed the Public Key and the Service/Template
# IDs to ship in frontend code.
#
# NEVER put your EmailJS *Private Key* here. It bypasses domain restrictions
# and belongs only in server-side code, which this project does not have.

# Email Services -> your Gmail service -> Service ID    (looks like: service_ab12cde)
VITE_EMAILJS_SERVICE_ID=

# Email Templates -> your template -> Template ID       (looks like: template_xy34fgh)
VITE_EMAILJS_TEMPLATE_ID=

# Account -> General -> Public Key                      (looks like: A1bC2dE3fG4hI5jK6)
VITE_EMAILJS_PUBLIC_KEY=
